# Copy to your server as .env (beside dashboard_collector.py) and fill local secrets.
# Do not commit the real .env file.

DASHBOARD_TZ=Asia/Taipei
DASHBOARD_CITY=Taipei
# Prefer fixed coordinates for weather accuracy. Leave blank only if using
# DASHBOARD_AUTO_LOCATION city-level IP fallback.
DASHBOARD_LAT=25.0330
DASHBOARD_LON=121.5654
DASHBOARD_OUTPUT=/var/www/esp32-dashboard/dashboard.json

# Optional CWA weather API settings.
CWA_API_KEY=
DASHBOARD_CWA_LOCATION=臺北市
DASHBOARD_CWA_STATION=臺北

# Collector behavior.
DASHBOARD_RAIN_ALERT_PCT=90
# 101 keeps forecast wording from painting a rain icon without observed rain.
DASHBOARD_RAIN_CONDITION_PCT=101
# Only the current hour drives alerts by default, and it must also predict
# meaningful precipitation depth; later hours remain visible in the strip.
DASHBOARD_RAIN_LOOKAHEAD_HOURS=0
DASHBOARD_RAIN_ALERT_PRECIP_MM=1.5
DASHBOARD_WEATHER_CACHE_TTL=90
DASHBOARD_AUTO_LOCATION=0
# Used only when DASHBOARD_AUTO_LOCATION=1 and no fixed coordinates are set.
DASHBOARD_NGINX_ACCESS_LOG=/var/log/nginx/esp32-dashboard.access.log
DASH_CCUSAGE_NPX_PACKAGE=ccusage@20.0.14
# Override only if Codex is not on PATH or you need a pinned binary.
# DASH_CODEX_APP_SERVER_CMD=codex app-server --stdio

# Keep the last successful Claude /status quota briefly when TUI capture flakes.
DASH_CLAUDE_QUOTA_CACHE_TTL=900
# DASH_CLAUDE_QUOTA_CACHE=/opt/esp32-dashboard/.claude_quota_cache.json
DASH_USD_TWD=32.5
